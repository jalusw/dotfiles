* {
  font: "FiraCode Nerd Font Mono 13";
  background-color: transparent;
  text-color: #E8E6F0;
}

configuration {
  show-icons: true;
  icon-theme: "Papirus";
  drun-icon-theme: "Papirus";
  display-drun: " Applications";
  display-run: " Run";
  display-filebrowser: " Files";
  display-window: " Windows";
  sidebar-mode: false;
  show-separator: false;
}

window {
  width: 660px;
  border-radius: 0;
  padding: 0;
  background-color: rgba(10, 10, 18, 0.92);
  border-color: #2F6BFF;
  border-width: 2px;
  cursor: "default";
}

mainbox {
  spacing: 0;
  children: [ inputbar, listview ];
}

inputbar {
  spacing: 10;
  padding: 14px 18px;
  children: [ prompt, entry ];
  background-color: #14141F;
  border-radius: 0;
  margin: 10px 10px 0 10px;
}

prompt {
  enabled: true;
  background-color: transparent;
  text-color: #9C9AB0;
  padding: 0 8px 0 0;
}

entry {
  background-color: transparent;
  text-color: #E8E6F0;
  cursor: text;
  placeholder: "Search...";
  placeholder-color: #9C9AB0;
  expand: true;
}

listview {
  spacing: 2;
  padding: 8px 10px 10px 10px;
  layout: vertical;
  cycle: true;
  background-color: transparent;
  cursor: "default";
  dynamic: true;
  scrollbar: false;
}

element {
  padding: 9px 12px;
  border-radius: 0;
  background-color: transparent;
  text-color: #E8E6F0;
  cursor: pointer;
}

element normal.normal {
  background-color: transparent;
  text-color: #E8E6F0;
}

element normal.urgent {
  background-color: transparent;
  text-color: #FF4E85;
}

element normal.active {
  background-color: transparent;
  text-color: #00FFC2;
}

element alternate.normal {
  background-color: transparent;
  text-color: #E8E6F0;
}

element alternate.urgent {
  background-color: transparent;
  text-color: #FF4E85;
}

element alternate.active {
  background-color: transparent;
  text-color: #00FFC2;
}

element selected.normal {
  background-color: #1EE8FF;
  text-color: #0A0A12;
}

element selected.urgent {
  background-color: #FF4E85;
  text-color: #0A0A12;
}

element selected.active {
  background-color: #00FFC2;
  text-color: #0A0A12;
}

element-icon {
  size: 32px;
  margin: 0 10px 0 4px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
}

scrollbar {
  width: 0px;
  border: 0;
  padding: 0;
}

button {
  background-color: transparent;
  text-color: #9C9AB0;
  cursor: pointer;
}

button selected {
  background-color: #1E1E2E;
  text-color: #E8E6F0;
}
