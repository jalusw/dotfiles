{
  "debug.javascript.autoAttachFilter": "onlyWithFlag",
  "editor.fontFamily": "FiraCode Nerd Font",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  "editor.lineNumbers": "relative",
  "glassit.alpha": 255,
  "editor.defaultFormatter": "ms-vscode-remote.remote-wsl",
  "editor.formatOnPaste": true,
  "vim.easymotion": true,
  "vim.neovimUseConfigFile": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.formatOnSave": true,
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "editor.wordWrap": "on",
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "svelte.ask-to-enable-ts-plugin": false,
  "workbench.activityBar.location": "top",
  "window.customTitleBarVisibility": "auto",
  "chat.editing.alwaysSaveWithGeneratedChanges": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": false,
  "workbench.colorTheme": "Default High Contrast",
  "workbench.iconTheme": "vscode-icons",
  "workbench.colorCustomizations": {
    "editor.background": "#0A0A12",
    "editor.foreground": "#E8E6F0",
    "editor.border": "#2A2A3D",
    "editorLineNumber.foreground": "#9C9AB0",
    "editorLineNumber.activeForeground": "#1EE8FF",
    "editor.selectionBackground": "#1EE8FF",
    "editor.selectionForeground": "#0A0A12",
    "editor.inactiveSelectionBackground": "#1E1E2E",
    "editorCursor.foreground": "#FF2E9A",
    "editorIndentGuide.background": "#2A2A3D",
    "editorIndentGuide.activeBackground": "#2A2A3D",
    "editorWidget.background": "#14141F",
    "editorWidget.border": "#2F6BFF",
    "editorError.foreground": "#FF4E85",
    "editorWarning.foreground": "#FFD93D",
    "editorInfo.foreground": "#1EE8FF",
    "editorHint.foreground": "#9B4DFF",
    "editorGutter.addedBackground": "#00FFC2",
    "editorGutter.modifiedBackground": "#FFD93D",
    "editorGutter.deletedBackground": "#FF4E85",
    "diffEditor.insertedTextBackground": "#00B3893F",
    "diffEditor.removedTextBackground": "#FF4E853F",
    "sideBar.background": "#0A0A12",
    "sideBar.border": "#2A2A3D",
    "activityBar.background": "#0A0A12",
    "activityBar.border": "#2A2A3D",
    "activityBar.activeBackground": "#14141F",
    "activityBar.foreground": "#9C9AB0",
    "activityBar.activeBorder": "#1EE8FF",
    "statusBar.background": "#14141F",
    "statusBar.foreground": "#E8E6F0",
    "statusBar.border": "#2A2A3D",
    "statusBarItem.hoverBackground": "#1E1E2E",
    "titleBar.activeBackground": "#0A0A12",
    "titleBar.activeForeground": "#E8E6F0",
    "panel.background": "#0A0A12",
    "panel.border": "#2A2A3D",
    "tab.activeBackground": "#14141F",
    "tab.inactiveBackground": "#0A0A12",
    "tab.activeForeground": "#1EE8FF",
    "tab.inactiveForeground": "#9C9AB0",
    "tab.border": "#2A2A3D",
    "input.background": "#14141F",
    "input.foreground": "#E8E6F0",
    "input.border": "#2A2A3D",
    "dropdown.background": "#14141F",
    "dropdown.border": "#2A2A3D",
    "button.background": "#1EE8FF",
    "button.foreground": "#0A0A12",
    "button.hoverBackground": "#2F6BFF",
    "list.hoverBackground": "#1E1E2E",
    "list.activeSelectionBackground": "#1E1E2E",
    "list.activeSelectionForeground": "#1EE8FF",
    "list.inactiveSelectionBackground": "#1E1E2E",
    "list.inactiveSelectionForeground": "#9C9AB0",
    "list.focusHighlightForeground": "#1EE8FF",
    "scrollbarSlider.background": "#2A2A3D",
    "scrollbarSlider.hoverBackground": "#2A2A3D",
    "terminal.background": "#0A0A12",
    "terminal.foreground": "#E8E6F0",
    "terminal.ansiBlack": "#0A0A12",
    "terminal.ansiRed": "#FF4E85",
    "terminal.ansiGreen": "#00FFC2",
    "terminal.ansiYellow": "#FFD93D",
    "terminal.ansiBlue": "#1EE8FF",
    "terminal.ansiMagenta": "#FF2E9A",
    "terminal.ansiCyan": "#4E81FF",
    "terminal.ansiWhite": "#E8E6F0",
    "terminal.ansiBrightBlack": "#2F2F36",
    "terminal.ansiBrightRed": "#FF6997",
    "terminal.ansiBrightGreen": "#26FFCB",
    "terminal.ansiBrightYellow": "#FFDF5A",
    "terminal.ansiBrightBlue": "#40EBFF",
    "terminal.ansiBrightMagenta": "#FF4DA9",
    "terminal.ansiBrightCyan": "#6994FF",
    "terminal.ansiBrightWhite": "#EBEBF2"
  },
  "workbench.editor.editorActionsLocation": "hidden",
  "git.openRepositoryInParentFolders": "never",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "workbench.sideBar.location": "right",
  "github.copilot.nextEditSuggestions.enabled": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.lineHeight": 38
}