[include]
  path = ~/.config/git/config

# Machine-specific overrides (not tracked)
# [include]
#   path = ~/.config/git/machine.conf
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
