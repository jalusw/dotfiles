#!/usr/bin/env bash
set -euo pipefail

dir="${SCRIPTS_DIR:-$HOME/scripts}"

[[ -d "$dir" ]] || { echo "Scripts directory not found: $dir" >&2; exit 1; }

mapfile -t scripts < <(find "$dir" -maxdepth 1 -type f -executable -printf '%f\n' | sort)

(( ${#scripts[@]} )) || { echo "No scripts found in $dir" >&2; exit 1; }

choice="$(printf '%s\n' "${scripts[@]}" | rofi -dmenu -i -p "Scripts" -config ~/.config/rofi/config.rasi)"

[[ -n "$choice" ]] || exit 0

script="$dir/$choice"

if grep -Eq '\b(sudo|pacman|yay|apt|dnf|systemctl|docker)\b' "$script"; then
  exec ghostty -e "$script"
fi

exec "$script"