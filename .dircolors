# Monochromatic dircolors (xterm-256 nearest matches to the palette)
# Apply with: eval "$(dircolors -b ~/.dircolors)"
# Palette → 256 index: primary #CCCCCC→250, light #E0E0E0→254, lighter #F0F0F0→255,
# dark #888888→102, darker #555555→59, muted #333333→236, fg0→254, fg1→250, border→236

# Terminals
TERM xterm-256color
TERM screen-256color
TERM tmux-256color
TERM alacritty

# Base attributes
RESET 0
NORMAL 00
FILE 00
DIR 01;38;5;250        # bold primary gray
LINK 38;5;102         # dark gray
MULTIHARDLINK 01;38;5;250
FIFO 38;5;254         # light gray
SOCK 38;5;102         # dark gray
DOOR 01;38;5;59       # darker gray
BLK 01;38;5;254
CHR 01;38;5;254
ORPHAN 01;38;5;59
MISSING 38;5;59
EXEC 01;38;5;255       # lighter gray
SETUID 01;38;5;59
SETGID 01;38;5;254
CAPABILITY 01
STICKY 01;38;5;254
OTHER_WRITABLE 01;38;5;254
STICKY_OTHER_WRITABLE 01;38;5;254

.tar 38;5;254
.tgz 38;5;254
.arc 38;5;254
.arj 38;5;254
.taz 38;5;254
.lha 38;5;254
.lz4 38;5;254
.lzh 38;5;254
.lz 38;5;254
.lzo 38;5;254
.xz 38;5;254
